<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VSCodeRecent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <WindowsSdkPackageVersion>10.0.26100.84</WindowsSdkPackageVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <!--
    关闭裁剪。CsWinRT 的 COM 激活走反射，裁剪后容易在运行时失效且难排查；
    本扩展体积很小，裁剪收益可以忽略。
  -->
  <PropertyGroup>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Shmuelie.WinRTServer" />

    <!-- 启用生成 MSIX 包（Single-project MSIX 工具链） -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 本项目的资源文件名没有 scale-200 后缀，用通配符包含实际存在的 PNG。
       MaterialIcons\ 下是按文件名关联的彩色图标（Material Icon Theme 派生，MIT），
       同样要打进包 —— IconHelpers 只接受包内相对路径，没有从流建图标的公开 API。 -->
  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\MaterialIcons\*.png" />
    <Content Include="Assets\MaterialIcons\NOTICE.md" />
  </ItemGroup>

  <!-- 关联表嵌进程序集：图标 PNG 必须留在磁盘上供宿主按路径读取，但关联表没有这个
       约束。嵌进来可以避免「包漏打一个文件 → 所有图标静默变默认」这类失败。
       LogicalName 显式写死，与 MaterialIconTheme.ResourceName 对应 —— 默认命名由
       路径推导（反斜杠转点），改目录名会悄悄改掉它，那会变成运行时找不到资源。 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\MaterialIcons\material-icons.json">
      <LogicalName>VSCodeRecent.Assets.MaterialIcons.material-icons.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- 测试项目在 tests\ 下，本项目的默认通配会把它们也编进来 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!--
    扩展类型一律 internal，不为了测试放开成 public —— 那会顺带扩大 COM 表面。
    只给测试程序集开一个口子。
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>VSCodeRecent.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    定义 "Msix" ProjectCapability 让 Single-project MSIX Packaging Tools 扩展生效，
    即使还没有还原 Windows App SDK NuGet 包。
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
